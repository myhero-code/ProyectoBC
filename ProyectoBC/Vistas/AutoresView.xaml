<UserControl x:Class="ProyectoBC.Vistas.AutoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL IZQUIERDO: FORMULARIO DE AUTOR -->
        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
            <StackPanel>
                <TextBlock Text="Gestión de Autores" FontSize="18" FontWeight="Bold" Foreground="#1A202C" Margin="0,0,0,16"/>

                <TextBlock Text="Nombre Completo del Autor *" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtNombreAutor" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                <TextBlock Text="Nacionalidad" FontSize="12" FontWeight="SemiBold" Foreground="#4A5568" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtNacionalidad" Height="36" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,20"/>

                <Button x:Name="BtnGuardarAutor" Content="Registrar Autor" Height="38" Background="#2B6CB0" Foreground="White"
                        FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnGuardarAutor_Click" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Limpiar" Height="34" Background="#EDF2F7" Foreground="#4A5568"
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnLimpiar_Click"/>
                    <Button Grid.Column="2" Content="Eliminar" Height="34" Background="#FED7D7" Foreground="#C53030"
                            FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnEliminarAutor_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- PANEL DERECHO: DIRECTORIO DE AUTORES -->
        <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Autores Registrados"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#1A202C"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="BtnImprimirReporte"
                                Content="Imprimir Reporte"
                                Click="BtnImprimirReporte_Click"
                                Height="34"
                                Padding="12,6"
                                Margin="0,0,10,0"
                                Background="#2563EB"
                                Foreground="White"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"/>

                        <TextBox x:Name="TxtBuscarAutor"
                                 Width="230"
                                 Height="34"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Buscar por nombre o nacionalidad..."
                                 TextChanged="TxtBuscarAutor_TextChanged"/>
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="DgAutores" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="White" BorderThickness="0" RowHeight="38" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EDF2F7" SelectionChanged="DgAutores_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ID_Autor}" Width="60"/>
                        <DataGridTextColumn Header="Nombre del Autor" Binding="{Binding Nombre_Autor}" Width="*"/>
                        <DataGridTextColumn Header="Nacionalidad" Binding="{Binding Nacionalidad}" Width="160"/>
                        <DataGridTextColumn Header="Libros Asociados" Binding="{Binding TotalLibros}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>