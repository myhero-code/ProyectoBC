<UserControl x:Class="ProyectoBC.Vistas.CatalogoLibrosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- FORMULARIO DE LIBRO -->
        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,20,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.05" Direction="270" ShadowDepth="4"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Gestión de Libros" FontSize="18" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,15"/>

                <TextBlock Text="Título del Libro *" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtTitulo" Height="34" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="Autor *" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbAutor" Height="34" DisplayMemberPath="Nombre_Autor" SelectedValuePath="ID_Autor" IsEditable="True" Margin="0,0,0,10"/>

                <TextBlock Text="Categoría *" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbCategoria" Height="34" DisplayMemberPath="Nombre_Categoria" SelectedValuePath="ID_Categoria" Margin="0,0,0,10"/>

                <TextBlock Text="Editorial" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtEditorial" Height="34" Padding="8,0" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Año Publicación" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtAnio" Height="34" Padding="8,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Género" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtGenero" Height="34" Padding="8,0" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Button x:Name="BtnGuardar" Content="Guardar Libro" Height="38" Background="#2B6CB0" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,0,8" Click="BtnGuardar_Click"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Limpiar" Height="34" Background="#EDF2F7" Foreground="#2D3748" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnLimpiar_Click"/>
                    <Button Grid.Column="2" Content="Eliminar" Height="34" Background="#FED7D7" Foreground="#C53030" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnEliminar_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- LISTADO DE LIBROS -->
        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.05" Direction="270" ShadowDepth="4"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Catálogo General de Libros" FontSize="18" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtBuscarLibro" Width="260" Height="34" HorizontalAlignment="Right" Padding="10,0" VerticalContentAlignment="Center" ToolTip="Buscar por título, autor o editorial..." TextChanged="TxtBuscarLibro_TextChanged"/>
                </Grid>

                <DataGrid Grid.Row="1" x:Name="DgLibros" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" Background="Transparent" BorderThickness="0" RowHeight="38"
                          SelectionChanged="DgLibros_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ID_Libro}" Width="55"/>
                        <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*"/>
                        <DataGridTextColumn Header="Autor" Binding="{Binding Nombre_Autor}" Width="160"/>
                        <DataGridTextColumn Header="Categoría" Binding="{Binding Nombre_Categoria}" Width="130"/>
                        <DataGridTextColumn Header="Editorial" Binding="{Binding Editorial}" Width="130"/>
                        <DataGridTextColumn Header="Año" Binding="{Binding Anio_Publicacion}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>