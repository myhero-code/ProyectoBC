<UserControl x:Class="ProyectoBC.Vistas.PrestamosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PANEL NUEVO PRÉSTAMO -->
        <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,20,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.05" Direction="270" ShadowDepth="4"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Registrar Préstamo" FontSize="18" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,15"/>

                <TextBlock Text="Seleccionar Lector *" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbLector" Height="34" DisplayMemberPath="LectorCompleto" SelectedValuePath="ID_Lector" IsEditable="True" Margin="0,0,0,12"/>

                <TextBlock Text="Seleccionar Libro *" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbLibro" Height="34" DisplayMemberPath="Titulo" SelectedValuePath="ID_Libro" IsEditable="True" Margin="0,0,0,12"/>

                <TextBlock Text="Fecha de Préstamo" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DatePicker x:Name="DpFechaPrestamo" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                <TextBlock Text="Fecha Límite Devolución *" Foreground="#4A5568" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <DatePicker x:Name="DpFechaDevolucion" Height="34" VerticalContentAlignment="Center" Margin="0,0,0,18"/>

                <Button Content="Confirmar Préstamo" Height="40" Background="#2B6CB0" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnRegistrarPrestamo_Click"/>

                <Separator Margin="0,25,0,20" Background="#E2E8F0"/>

                <TextBlock Text="Devolución Rápida" FontSize="15" FontWeight="Bold" Foreground="#2D3748" Margin="0,0,0,8"/>
                <TextBlock Text="Seleccione un préstamo activo de la tabla para registrar su devolución. Si está atrasado se generará multa (5 Bs/día)." TextWrapping="Wrap" Foreground="#718096" FontSize="12" Margin="0,0,0,12"/>
                <Button Content="✓ Marcar como Devuelto" Height="38" Background="#38A169" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnDevolver_Click"/>
            </StackPanel>
        </Border>

        <!-- LISTADO DE PRÉSTAMOS -->
        <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.05" Direction="270" ShadowDepth="4"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock Text="Historial de Préstamos y Devoluciones" FontSize="18" FontWeight="Bold" Foreground="#2D3748" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbFiltroEstado" Width="160" Height="34" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="CmbFiltroEstado_SelectionChanged">
                        <ComboBoxItem Content="Todos"/>
                        <ComboBoxItem Content="Activo"/>
                        <ComboBoxItem Content="Devuelto"/>
                    </ComboBox>
                </Grid>

                <DataGrid Grid.Row="1" x:Name="DgPrestamos" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" Background="Transparent" BorderThickness="0" RowHeight="38">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ID_Prestamo}" Width="60"/>
                        <DataGridTextColumn Header="Lector" Binding="{Binding Lector}" Width="190"/>
                        <DataGridTextColumn Header="Libro" Binding="{Binding Titulo}" Width="*"/>
                        <DataGridTextColumn Header="Préstamo" Binding="{Binding Fecha_Prestamo, StringFormat=dd/MM/yyyy}" Width="110"/>
                        <DataGridTextColumn Header="Devolución" Binding="{Binding Fecha_Devolucion, StringFormat=dd/MM/yyyy}" Width="110"/>
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>