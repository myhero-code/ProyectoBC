<Window x:Class="ProyectoBC.PortalLectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biblioteca Municipal - Portal del Lector" Height="740" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1A202C" Padding="25,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2B6CB0" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                        <TextBlock Text="BM" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BIBLIOTECA MUNICIPAL" Foreground="White" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="Portal de Lectores y Reservas" Foreground="#A0AEC0" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BtnNavCatalogo" Content="📚 Catálogo y Reservas" Height="38" Padding="18,0"
                            Background="#2B6CB0" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Margin="0,0,10,0" Cursor="Hand" Click="BtnNavCatalogo_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="BtnNavMisPrestamos" Content="📋 Mis Reservas, Préstamos y Multas" Height="38" Padding="18,0"
                            Background="Transparent" Foreground="#CBD5E0" FontWeight="SemiBold" BorderThickness="0"
                            Cursor="Hand" Click="BtnNavMisPrestamos_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                        <TextBlock x:Name="TxtNombreLectorHeader" Text="Bienvenido, Lector" Foreground="White" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="TxtCiLectorHeader" Text="CI: ---" Foreground="#90CDF4" FontSize="11" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <Button Content="Cerrar Sesión" Height="34" Padding="14,0" Background="#E53E3E" Foreground="White"
                            FontWeight="SemiBold" FontSize="12" BorderThickness="0" Cursor="Hand" Click="BtnCerrarSesion_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="1">
            <!-- VISTA A: CATÁLOGO DE LIBROS EN TARJETAS CON PORTADA -->
            <Grid x:Name="VistaCatalogo" Visibility="Visible" Margin="25,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="18,14" Margin="0,0,0,18">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="240"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="TxtBuscarLibro" Height="38" Padding="12,0" VerticalContentAlignment="Center"
                                     FontSize="13" BorderBrush="#CBD5E0" TextChanged="FiltroCatalogo_Changed"/>
                            <TextBlock x:Name="PlaceholderLibro" Text="🔍 Buscar libro por título, autor o editorial..."
                                       Foreground="#A0AEC0" VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
                        </Grid>

                        <ComboBox x:Name="CmbFiltroCategoria" Grid.Column="2" Height="38" VerticalContentAlignment="Center"
                                  FontSize="13" SelectionChanged="FiltroCatalogo_Changed"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ListaTarjetasLibros">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" Width="270" Height="360" Margin="0,0,18,18"
                                        CornerRadius="12" Padding="14">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="12" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="145"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Categoría y Estado -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Border Background="#EBF8FF" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Categoria}" Foreground="#2B6CB0" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="{Binding ColorEstado}" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding EstadoDisponibilidad}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>

                                        <!-- Portada del Libro -->
                                        <Border Grid.Row="1" Background="#EDF2F7" CornerRadius="8" ClipToBounds="True" Margin="0,0,0,10">
                                            <Grid>
                                                <TextBlock Text="📖" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A0AEC0"/>
                                                <Image Source="{Binding ImagenPortada}" Stretch="Uniform"/>
                                            </Grid>
                                        </Border>

                                        <!-- Título, Autores y Editorial -->
                                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Titulo}" FontSize="14" FontWeight="Bold" Foreground="#1A202C"
                                                       TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Autor}" FontSize="12" Foreground="#4A5568" Margin="0,4,0,2"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding EditorialAnio}" FontSize="11" Foreground="#718096"/>
                                        </StackPanel>

                                        <!-- Botón Reservar (2h) -->
                                        <Button Grid.Row="3" Content="{Binding TextoBoton}" IsEnabled="{Binding PuedeReservar}"
                                                Background="{Binding ColorBoton}" Foreground="White" Height="34" Margin="0,8,0,0"
                                                FontWeight="Bold" FontSize="12" BorderThickness="0" Cursor="Hand"
                                                Click="BtnReservarLibro_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="7"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- VISTA B: MIS RESERVAS, PRÉSTAMOS Y MULTAS -->
            <Grid x:Name="VistaMisPrestamos" Visibility="Collapsed" Margin="25,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Mis Reservas y Préstamos" FontSize="18" FontWeight="Bold" Foreground="#1A202C" VerticalAlignment="Center"/>
                            <Button Content="🖨️ Ver / Imprimir Ticket de Reserva" HorizontalAlignment="Right" Height="32" Padding="12,0"
                                    Background="#2B6CB0" Foreground="White" FontWeight="SemiBold" FontSize="12" BorderThickness="0"
                                    Cursor="Hand" Click="BtnReimprimirTicket_Click"/>
                        </Grid>

                        <DataGrid x:Name="DgMisPrestamos" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="White" BorderThickness="0" RowHeight="36" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EDF2F7" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="N°" Binding="{Binding ID_Prestamo}" Width="50"/>
                                <DataGridTextColumn Header="Libro" Binding="{Binding Titulo}" Width="*"/>
                                <DataGridTextColumn Header="Límite Recojo / Dev." Binding="{Binding FechaReferencia}" Width="145"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Mis Multas" FontSize="18" FontWeight="Bold" Foreground="#1A202C" Margin="0,0,0,15"/>
                        <DataGrid x:Name="DgMisMultas" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="White" BorderThickness="0" RowHeight="36" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EDF2F7">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha_Emision, StringFormat=dd/MM/yyyy}" Width="95"/>
                                <DataGridTextColumn Header="Monto (Bs)" Binding="{Binding Monto}" Width="90"/>
                                <DataGridTextColumn Header="Estado Pago" Binding="{Binding EstadoPago}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#1A202C" Padding="25,0">
            <Grid>
                <TextBlock Text="© 2026 Biblioteca Municipal - Sistema de Reservas y Consulta en Línea (ProyectoBC)"
                           Foreground="#A0AEC0" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock Text="Las reservas en línea tienen una vigencia máxima de 2 horas para su recojo."
                           Foreground="#90CDF4" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>