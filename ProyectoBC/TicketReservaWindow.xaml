<Window x:Class="ProyectoBC.TicketReservaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comprobante de Reserva - Biblioteca Municipal" Height="540" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#EDF2F7">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ÁREA IMPRIMIBLE (TICKET) -->
        <Border x:Name="AreaImpresionTicket" Grid.Row="0" Background="White" CornerRadius="10" Padding="24" BorderBrush="#CBD5E0" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="BIBLIOTECA MUNICIPAL" FontSize="17" FontWeight="Bold" Foreground="#1A202C" HorizontalAlignment="Center"/>
                <TextBlock Text="COMPROBANTE DE RESERVA EN LÍNEA" FontSize="11" FontWeight="SemiBold" Foreground="#2B6CB0" HorizontalAlignment="Center" Margin="0,2,0,12"/>

                <Separator Margin="0,0,0,12"/>

                <TextBlock x:Name="TxtCodigoReserva" Text="N° RESERVA: #0000" FontSize="15" FontWeight="Bold" Foreground="#1A202C" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <TextBlock Text="LECTOR SOLICITANTE:" FontSize="10" FontWeight="Bold" Foreground="#718096"/>
                <TextBlock x:Name="TxtLectorTicket" Text="Nombre del Lector" FontSize="13" FontWeight="SemiBold" Foreground="#1A202C" Margin="0,2,0,4"/>
                <TextBlock x:Name="TxtCiTicket" Text="CI: 0000000" FontSize="12" Foreground="#4A5568" Margin="0,0,0,12"/>

                <TextBlock Text="LIBRO RESERVADO:" FontSize="10" FontWeight="Bold" Foreground="#718096"/>
                <TextBlock x:Name="TxtLibroTicket" Text="Título del Libro" FontSize="13" FontWeight="Bold" Foreground="#1A202C" TextWrapping="Wrap" Margin="0,2,0,2"/>
                <TextBlock x:Name="TxtCodigoLibroTicket" Text="Código: LIB-0" FontSize="11" Foreground="#4A5568" Margin="0,0,0,14"/>

                <Border Background="#FFFBEB" BorderBrush="#F6E05E" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="⏳ TIEMPO LÍMITE PARA RECOGER:" FontSize="10" FontWeight="Bold" Foreground="#B7791F" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtHoraLimite" Text="Hoy hasta las 17:00" FontSize="14" FontWeight="Bold" Foreground="#975A16" HorizontalAlignment="Center" Margin="0,3,0,2"/>
                        <TextBlock Text="Presenta este comprobante y tu CI en mostrador antes de la hora indicada o la reserva expirará." FontSize="10" Foreground="#744210" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TxtFechaEmision" Text="Emitido: 00/00/0000 00:00" FontSize="10" Foreground="#A0AEC0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- BOTONES DE ACCIÓN (NO SE IMPRIMEN) -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Cerrar" Height="38" Background="#CBD5E0" Foreground="#1A202C" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="BtnCerrar_Click"/>

            <Button Grid.Column="2" Content="🖨️ Imprimir Comprobante" Height="38" Background="#2B6CB0" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnImprimir_Click"/>
        </Grid>
    </Grid>
</Window>